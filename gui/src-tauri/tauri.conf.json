{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phpenv",
  "version": "0.1.0",
  "identifier": "dev.phpenv.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHP Environment Manager",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "phpenv-daemon"
    ],
    "resources": []
  },
  "plugins": {
    "shell": {
      "sidecar": [
        {
          "name": "phpenv-daemon",
          "command": "phpenv-daemon",
          "args": true
        }
      ]
    }
  }
}